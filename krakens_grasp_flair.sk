# KRAKEN'S GRASP — cosmetic only: ink, splashes and squelches around a cast.
# The rod's own line (a glowing spectral tentacle) and its little kraken bobber are
# drawn by FishingCore (rod-cosmetics in its config); this adds the effects at the
# moments of the cast: a squirt as you cast, a glowing splash as the bobber lands,
# ink when a fish bites and a splash when you reel in. Nothing about the catch changes.
# Needs krakens_grasp.sk (kgWorn). /sk reload krakens_grasp_flair
import:
    org.bukkit.Color
    org.bukkit.Particle
    org.bukkit.Particle$DustTransition as KrakenFade
    org.bukkit.Particle$DustOptions as KrakenDust
    org.bukkit.event.player.PlayerFishEvent

# The skin on whichever hand holds a skinned rod, or nothing.
function kgFxRod(p: player) :: text:
    set {_inv} to {_p}.getInventory()
    set {_s} to kgWorn({_inv}.getItemInMainHand())
    if {_s} is not set:
        set {_s} to kgWorn({_inv}.getItemInOffHand())
    return {_s}

function kgFxOk(p: player) :: boolean:
    {_p}.isOnline() is true
    {_p}.isDead() is false
    "%{_p}.getGameMode().name()%" is not "SPECTATOR"
    {_p}.isInvisible() is false
    {_p}.hasMetadata("vanished") is false
    kgFxRod({_p}) is set
    return true

function kgCast(p: player, hook: object):
    set {_u} to "%uuid of {_p}%"
    add 1 to {-kg.cast::%{_u}%}
    set {_gen} to {-kg.cast::%{_u}%}
    play sound "entity.squid.squirt" with volume 0.6 and pitch 0.6 at {_p}
    play sound "item.trident.riptide_1" with volume 0.25 and pitch 1.6 at {_p}
    set {_t} to 0
    # Every pass waits FIRST and leaves with an explicit stop: in Skript a failed condition
    # inside a while loop just starts the next pass, so a check placed before the wait spins the
    # server thread forever (the bobber doesn't exist yet when the cast event fires).
    while {_t} < 600:
        wait 2 ticks
        add 2 to {_t}
        if {-kg.cast::%{_u}%} is not {_gen}:
            stop
        if {_hook}.isValid() is not true:
            stop
        if {_hook}.isInWater() is true:
            {_hook}.getWorld().spawnParticle(Particle.SPLASH, {_hook}.getLocation(), 14, 0.3, 0.05, 0.3, 0.1)
            {_hook}.getWorld().spawnParticle(Particle.GLOW_SQUID_INK, {_hook}.getLocation(), 5, 0.2, 0.05, 0.2, 0.02)
            play sound "entity.glow_squid.ambient" with volume 0.5 and pitch 0.6 at {_hook}.getLocation()
            stop

on PlayerFishEvent with priority monitor:
    set {_e} to event
    {_e}.isCancelled() is false
    set {_p} to {_e}.getPlayer()
    set {_state} to "%{_e}.getState().name()%"
    set {_hook} to {_e}.getHook()
    if {_state} is "FISHING":
        kgFxOk({_p}) is true
        kgCast({_p}, {_hook})
    else if {_state} is "BITE":
        kgFxOk({_p}) is true
        # the tentacle squeezes the bobber
        {_hook}.getWorld().spawnParticle(Particle.GLOW_SQUID_INK, {_hook}.getLocation().add(0, 0.3, 0), 8, 0.15, 0.15, 0.15, 0.03)
        play sound "entity.glow_squid.squirt" with volume 0.6 and pitch 1.3 at {_hook}.getLocation()
    else if {_state} is "CAUGHT_FISH" or "REEL_IN" or "CAUGHT_ENTITY" or "IN_GROUND" or "FAILED_ATTEMPT":
        set {_u} to "%uuid of {_p}%"
        add 1 to {-kg.cast::%{_u}%}
        kgFxRod({_p}) is set
        # it lets go and splashes back down
        {_hook}.getWorld().spawnParticle(Particle.SQUID_INK, {_hook}.getLocation().add(0, 0.2, 0), 10, 0.25, 0.2, 0.25, 0.05)
        {_hook}.getWorld().spawnParticle(Particle.DUST_COLOR_TRANSITION, {_hook}.getLocation().add(0, 0.4, 0), 18, 0.35, 0.35, 0.35, 0, new KrakenFade(Color.fromRGB(110, 245, 232), Color.fromRGB(176, 104, 255), 1.0))
        play sound "entity.squid.squirt" with volume 0.7 and pitch 0.8 at {_hook}.getLocation()

on quit:
    delete {-kg.cast::%uuid of player%}
