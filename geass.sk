# GEASS — serialized helmet skin (Lelouch's Geass, Code Geass). Requires Skript +
# skript-reflect. No plugin / restart. Assets: the Elytro pack (equipment elytro:geass and
# elytro:geass_active, built by elytro-packs/extra/geass_build.py).
# Works like Kraken's Grasp (krakens_grasp.sk): the skin is a voucher; drop it onto a helmet in
# your own inventory, confirm, and that helmet wears it from then on. Worn, the helmet itself
# vanishes: all that shows is a red Geass sigil glowing over your left eye. The helmet keeps
# its armour, enchants and durability; only the look changes.
#   Activate: sneak + swap hands (F) while wearing it, or /geass. The sigil flares into its full
#   winged form, your screen takes on a red vignette, and the Geass fires out of your eye: the
#   sigil blooms at your face and three spinning sigils (pack models on display entities, the
#   Geass's own particles) fly to whatever you're looking at.
#   Looking at a player (op or elytro.geass.command): a menu of orders opens first. Pick one and
#   the sigils fly into their eyes, a red Geass ring closes over their face with the order
#   floating above, and they obey (nothing is announced in chat; you get a private action bar):
#   speak (you type the line), all hail <you>, kneel, look at me, follow me, leap, spin, run,
#   do not move (transient attribute modifiers, never saved), dance, rise, sleep, forget, live,
#   fight for me (real attacks on whoever's nearest, so PvP rules decide) and possess (10s in
#   their body: spectator camera on them, your keys drive them, your chat speaks as them).
#   Like C.C., a player explicitly granted elytro.geass.immune shrugs it off.
# /zero (owners: op or elytro.geass.zero) puts on Zero's whole outfit over the armour you wear
#   (stats kept; empty slots get made-up pieces): the mask (3D head model whose left-eye
#   shutter slides open when the Geass fires), the suit, and the cloak (the chest's wings layer).
#   /zero again takes it off. Pack assets: elytro-packs/extra/zero_build.py.
# /geass                       activate (while wearing it)
# /geass give <player> | test | clearserial | revoke <serial> | inspect <serial>   (staff)
# /sk reload geass
# Preserve {geass.serial}, {geass.state::*}, {geass.log::*}, {geass.token::*} and
# {geass.free::*} in Skript's persistent variable storage when wiping player data.

import:
    org.bukkit.Bukkit
    org.bukkit.Color
    org.bukkit.Material
    org.bukkit.NamespacedKey
    org.bukkit.Particle
    org.bukkit.Particle$DustOptions as GeassDust
    org.bukkit.Sound
    org.bukkit.inventory.EquipmentSlot
    org.bukkit.inventory.ItemStack
    org.bukkit.persistence.PersistentDataType
    org.bukkit.event.inventory.InventoryClickEvent
    org.bukkit.event.inventory.InventoryCloseEvent
    org.bukkit.event.inventory.InventoryDragEvent
    org.bukkit.event.player.PlayerSwapHandItemsEvent
    org.bukkit.util.Vector
    java.util.ArrayList
    java.util.UUID
    org.bukkit.event.server.TabCompleteEvent
    org.bukkit.entity.ItemDisplay
    org.bukkit.entity.TextDisplay
    org.bukkit.entity.LivingEntity
    org.bukkit.entity.Display$Billboard as GeassBillboard
    org.bukkit.entity.Display$Brightness as GeassBrightness
    org.bukkit.util.Transformation
    org.joml.Vector3f
    org.joml.Quaternionf
    org.bukkit.potion.PotionEffect
    org.bukkit.potion.PotionEffectType
    org.bukkit.attribute.Attribute
    org.bukkit.attribute.AttributeModifier
    org.bukkit.attribute.AttributeModifier$Operation as GeassOp
    org.bukkit.inventory.EquipmentSlotGroup
    io.papermc.paper.entity.LookAnchor
    net.kyori.adventure.title.Title
    net.kyori.adventure.title.Title$Times as GeassTimes
    java.time.Duration
    org.bukkit.GameMode
    org.bukkit.entity.Monster
    org.bukkit.entity.Pose
    net.kyori.adventure.text.minimessage.MiniMessage
    net.kyori.adventure.text.serializer.plain.PlainTextComponentSerializer

options:
    name: &4&lGeass
    p: &4&lGeass &8»
    skinline: ✦ Geass skin applied
    skinmm: <!italic><red>✦ Geass skin applied
    # seconds the Geass stays lit, and between activations
    lit: 5
    cooldown: 8

function gsKey(k: text) :: object:
    return NamespacedKey.fromString("elytro:%{_k}%")

function gsItem(s: text) :: item:
    set {_i} to new ItemStack(Material.PAPER)
    set {_m} to {_i}.getItemMeta()
    {_m}.setItemModel(gsKey("geass"))
    {_m}.setMaxStackSize(1)
    {_m}.getPersistentDataContainer().set(gsKey("geass_serial"), PersistentDataType.STRING, {_s})
    if {_s} is not "test":
        if {geass.token::%{_s}%} is set:
            {_m}.getPersistentDataContainer().set(gsKey("geass_token"), PersistentDataType.STRING, {geass.token::%{_s}%})
    {_i}.setItemMeta({_m})
    set name of {_i} to "{@name}"
    set lore of {_i} to "&c&lMythic &8Helmet skin", "", "&c&o""Lelouch vi Britannia commands you!""", "&8&o- Lelouch vi Britannia", "", "&7Worn, the helmet vanishes: all that", "&7shows is a red &cGeass &7over your eye.", "&7Sneak + swap hands to unleash it.", "", "&7Drop it onto a &chelmet &7to apply.", "" and "&8#%{_s}%"
    if {_s} is "test":
        set lore of {_i} to "&c&lMythic &8Helmet skin", "", "&c&o""Lelouch vi Britannia commands you!""", "&8&o- Lelouch vi Britannia", "", "&7Worn, the helmet vanishes: all that", "&7shows is a red &cGeass &7over your eye.", "&7Sneak + swap hands to unleash it.", "", "&7Drop it onto a &chelmet &7to apply.", "" and "&8Test copy - no serial"
    return {_i}

function gsSerial(i: object) :: text:
    {_i} is set
    {_i}.hasItemMeta() is true
    return {_i}.getItemMeta().getPersistentDataContainer().get(gsKey("geass_serial"), PersistentDataType.STRING)

function gsToken(i: object) :: text:
    if {_i} is set:
        if {_i}.hasItemMeta() is true:
            set {_t} to {_i}.getItemMeta().getPersistentDataContainer().get(gsKey("geass_token"), PersistentDataType.STRING)
    return {_t} ? "legacy"

function gsValid(s: text, t: text) :: boolean:
    if {_s} is "test":
        return true
    set {_state} to {geass.state::%{_s}%}
    if {_state} is not "ISSUED":
        if {_state} is not "APPLIED":
            return false
    if {geass.token::%{_s}%} is set:
        if {geass.token::%{_s}%} is not {_t}:
            return false
    else if {_t} is not "legacy":
        return false
    return true

function gsRedeemable(s: text, t: text) :: boolean:
    if gsValid({_s}, {_t}) is not true:
        return false
    if {_s} is "test":
        return true
    if {geass.state::%{_s}%} is "ISSUED":
        return true
    return false

function gsHasSpace(p: player) :: boolean:
    set {_inv} to {_p}.getInventory()
    loop 36 times:
        set {_space} to {_inv}.getItem(loop-number - 1)
        if {_space} is not set:
            return true
        if {_space}.getType().isAir() is true:
            return true
    return false

function gsGiveTest(p: player):
    if gsHasSpace({_p}) is not true:
        send "{@p} &7Free one inventory slot first." to {_p}
        stop
    give gsItem("test") to {_p}
    send "{@p} &7Gave you a &ctest copy &8(no serial)&7. No reward number was used." to {_p}

function gsIssue(p: player, why: text) :: text:
    if size of {geass.free::*} > 0:
        set {_n} to min({geass.free::*})
        remove {_n} from {geass.free::*}
        set {_s} to "%{_n}%"
    else:
        add 1 to {geass.serial}
        set {_s} to "%{geass.serial}%"
    set {geass.token::%{_s}%} to "%UUID.randomUUID()%"
    set {geass.state::%{_s}%} to "ISSUED"
    set {geass.log::%{_s}%} to "issued to %{_p}.getName()% %uuid of {_p}% (%{_why}%) %now%"
    set {_item} to gsItem({_s})
    set {_left} to {_p}.getInventory().addItem({_item})
    if {_left}.isEmpty() is not true:
        {_p}.getWorld().dropItem({_p}.getLocation(), {_item})
        send "{@p} &7Your inventory was full, so it's at your feet." to {_p}
    send "[geass] #%{_s}% issued to %{_p}.getName()% (%{_why}%)" to console
    return {_s}

function gsRetire(s: text, who: text) :: boolean:
    if {_s} is "test":
        return false
    if {geass.state::%{_s}%} is not set:
        return false
    if {geass.state::%{_s}%} is "REVOKED":
        return false
    set {_n} to {_s} parsed as integer
    if {_n} is not set:
        return false
    if {_n} < 1:
        return false
    add "#%{_s}% | %{geass.log::%{_s}%}% | revoked by %{_who}% %now%" to {geass.revoked::*}
    set {geass.state::%{_s}%} to "REVOKED"
    set {geass.log::%{_s}%} to "%{geass.log::%{_s}%}% | revoked by %{_who}% %now%"
    delete {geass.token::%{_s}%}
    if {geass.free::*} does not contain {_n}:
        add {_n} to {geass.free::*}
    return true

function gsIsHelmet(i: object) :: boolean:
    {_i} is set
    "%{_i}.getType().name()%" ends with "_HELMET"
    {_i}.getAmount() is 1
    return true

# Put the helmet's worn look (and item model) to `look` ("geass", "geass_active"), or back to
# what it was before the skin when look is "none". Works on the meta; the caller saves it.
function gsSetLook(m: object, look: text):
    set {_prev} to {_m}.getPersistentDataContainer().get(gsKey("geass_prev"), PersistentDataType.STRING)
    if {_look} is "none":
        if {_prev} is not set:
            stop
        if {_prev} is "none":
            {_m}.setEquippable(null)
        else:
            set {_eq} to {_m}.getEquippable()
            {_eq}.setModel(NamespacedKey.fromString({_prev}))
            {_eq}.setCameraOverlay(null)
            {_m}.setEquippable({_eq})
        {_m}.getPersistentDataContainer().remove(gsKey("geass_prev"))
        {_m}.getPersistentDataContainer().remove(gsKey("geass_lit"))
        {_m}.getPersistentDataContainer().remove(gsKey("geass_zero"))
        if "%{_m}.getItemModel()%" is "elytro:geass" or "elytro:zero_mask":
            {_m}.setItemModel(null)
            gsFrame({_m}, "")
        stop
    if {_prev} is not set:
        # remember the helmet's own look so taking the skin off restores it
        set {_was} to "none"
        if {_m}.hasEquippable() is true:
            if {_m}.getEquippable().getModel() is set:
                set {_was} to "%{_m}.getEquippable().getModel()%"
        {_m}.getPersistentDataContainer().set(gsKey("geass_prev"), PersistentDataType.STRING, {_was})
        set {_fresh} to true
    set {_eq} to {_m}.getEquippable()
    if {_fresh} is true:
        if {_m}.hasEquippable() is not true:
            {_eq}.setEquipSound(Sound.ITEM_ARMOR_EQUIP_GENERIC)
    {_eq}.setSlot(EquipmentSlot.HEAD)
    set {_zero} to {_m}.getPersistentDataContainer().has(gsKey("geass_zero"), PersistentDataType.STRING)
    if {_zero} is true:
        # Zero's mask: no equipment model, so the item model itself is worn on the head; silent,
        # because the eye shutter's frames swap the helmet several times
        {_eq}.setModel(null)
        {_eq}.setEquipSound(Sound.INTENTIONALLY_EMPTY)
    else:
        {_eq}.setModel(gsKey({_look}))
        if "%{_eq}.getEquipSound()%" contains "intentionally_empty":
            {_eq}.setEquipSound(Sound.ITEM_ARMOR_EQUIP_GENERIC)
    if {_look} is "geass_active":
        {_eq}.setCameraOverlay(gsKey("misc/geass_overlay"))
    else:
        {_eq}.setCameraOverlay(null)
    {_m}.setEquippable({_eq})
    if {_zero} is true:
        {_m}.setItemModel(gsKey("zero_mask"))
        if {_look} is "geass_active":
            gsFrame({_m}, "open")
        else:
            gsFrame({_m}, "closed")
    else:
        {_m}.setItemModel(gsKey("geass"))
        gsFrame({_m}, "")

# The Zero mask's shutter frame (custom_model_data string); "" clears it.
function gsFrame(m: object, frame: text):
    set {_c} to {_m}.getCustomModelDataComponent()
    set {_l} to new ArrayList()
    if {_frame} is not "":
        {_l}.add({_frame})
    else if {_c}.getStrings().isEmpty() is true:
        stop
    {_c}.setStrings({_l})
    {_m}.setCustomModelDataComponent({_c})

# The skin a helmet is wearing (valid, with the look on it), or nothing.
function gsWorn(i: object) :: text:
    gsIsHelmet({_i}) is true
    {_i}.hasItemMeta() is true
    "%{_i}.getItemMeta().getItemModel()%" is "elytro:geass" or "elytro:zero_mask"
    set {_s} to {_i}.getItemMeta().getPersistentDataContainer().get(gsKey("geass_skin"), PersistentDataType.STRING)
    {_s} is set
    gsValid({_s}, gsToken({_i})) is true
    return {_s}

# Returns a changed copy only when needed: the skin line, a revoked skin taken off (the helmet's
# own look restored), and an activation that has run out put back to the resting sigil.
function gsLore(i: object) :: object:
    gsIsHelmet({_i}) is true
    {_i}.hasItemMeta() is true
    set {_m} to {_i}.getItemMeta()
    set {_s} to {_m}.getPersistentDataContainer().get(gsKey("geass_skin"), PersistentDataType.STRING)
    set {_active} to false
    if {_s} is set:
        if gsValid({_s}, gsToken({_i})) is not true:
            {_m}.getPersistentDataContainer().remove(gsKey("geass_skin"))
            {_m}.getPersistentDataContainer().remove(gsKey("geass_token"))
            gsSetLook({_m}, "none")
            set {_changed} to true
            delete {_s}
    if {_s} is set:
        if "%{_m}.getItemModel()%" is "elytro:geass" or "elytro:zero_mask":
            set {_active} to true
            set {_lit} to {_m}.getPersistentDataContainer().get(gsKey("geass_lit"), PersistentDataType.STRING) parsed as number
            if {_lit} is set:
                if {_lit} < Bukkit.getServer().getWorlds().get(0).getGameTime():
                    {_m}.getPersistentDataContainer().remove(gsKey("geass_lit"))
                    gsSetLook({_m}, "geass")
                    set {_changed} to true
        else:
            # a later skin wins
            {_m}.getPersistentDataContainer().remove(gsKey("geass_skin"))
            set {_changed} to true
    set {_want} to "{@skinline} #%{_s}%"
    set {_skintext} to "{@skinmm} <gray>#%{_s}%"
    if {_s} is "test":
        set {_want} to "{@skinline} (Test — no serial)"
        set {_skintext} to "{@skinmm} <dark_gray>(Test — no serial)"
    set {_plain} to PlainTextComponentSerializer.plainText()
    set {_lines} to new ArrayList()
    set {_old} to {_m}.lore()
    set {_at} to -1
    if {_old} is set:
        loop ...{_old}:
            set {_t} to {_plain}.serialize(loop-value)
            if {_t} starts with "{@skinline}":
                set {_had} to true
                if {_t} is not {_want}:
                    set {_changed} to true
            else:
                if {_at} is -1:
                    if {_t} is "":
                        set {_at} to {_lines}.size()
                {_lines}.add(loop-value)
    if {_active} is true:
        if {_had} is true:
            if {_changed} is not set:
                stop
        if {_at} is -1:
            set {_at} to {_lines}.size()
        {_lines}.add({_at}, MiniMessage.miniMessage().deserialize({_skintext}))
    else:
        if {_had} is not set:
            if {_changed} is not set:
                stop
    {_m}.lore({_lines})
    {_i}.setItemMeta({_m})
    return {_i}

function gsSyncInv(p: player):
    set {_inv} to {_p}.getInventory()
    loop 36 times:
        set {_n} to loop-number - 1
        set {_i} to gsLore({_inv}.getItem({_n}))
        if {_i} is set:
            {_inv}.setItem({_n}, {_i})
    set {_head} to gsLore({_inv}.getHelmet())
    if {_head} is set:
        {_inv}.setHelmet({_head})

function gsScrubInv(inv: object) :: number:
    set {_n} to 0
    loop {_inv}.getSize() times:
        set {_slot} to loop-number - 1
        set {_it} to {_inv}.getItem({_slot})
        set {_s} to gsSerial({_it})
        if {_s} is set:
            if gsRedeemable({_s}, gsToken({_it})) is not true:
                {_inv}.setItem({_slot}, null)
                add 1 to {_n}
        else if gsIsHelmet({_it}) is true:
            if {_it}.hasItemMeta() is true:
                set {_had} to {_it}.getItemMeta().getPersistentDataContainer().get(gsKey("geass_skin"), PersistentDataType.STRING)
                set {_fixed} to gsLore({_it})
                if {_fixed} is set:
                    {_inv}.setItem({_slot}, {_fixed})
                    if {_had} is set:
                        if gsValid({_had}, gsToken({_it})) is not true:
                            add 1 to {_n}
    return {_n}

function gsScrubOnline() :: number:
    set {_n} to 0
    loop all players:
        add gsScrubInv(loop-player.getInventory()) to {_n}
        add gsScrubInv(loop-player.getEnderChest()) to {_n}
    return {_n}

# ------------------------ applying it ------------------------

function gsOpen(p: player, slot: number, s: text, snapshot: object, token: text):
    set {_u} to "%uuid of {_p}%"
    set {_inv} to chest inventory with 3 rows named "&8Apply the Geass?"
    set {_pane} to black stained glass pane named " "
    loop 27 times:
        set slot (loop-number - 1) of {_inv} to {_pane}
    set {_info} to gsItem({_s})
    set lore of {_info} to "&cGeass #%{_s}%", "", "&7This changes only the helmet's look.", "&7Its armour, enchants and durability stay.", "", "&cAny skin it wears now is replaced permanently.", "&7The voucher is used only on Confirm."
    if {_s} is "test":
        set lore of {_info} to "&cTEST COPY &8— no serial", "", "&7Try the look without using a reward number.", "&7Its armour, enchants and durability stay.", "", "&cAny skin it wears now is still replaced."
    set slot 13 of {_inv} to {_info}
    set slot 11 of {_inv} to red stained glass pane named "&cCancel" with lore "&7Keep the voucher. Nothing changes."
    set slot 15 of {_inv} to lime stained glass pane named "&aApply permanently" with lore "&7Uses up the skin voucher." and "&cReplaces the helmet's current skin."
    open {_inv} to {_p}
    set {-gsconfirm::%{_u}%::slot} to {_slot}
    set {-gsconfirm::%{_u}%::serial} to {_s}
    set {-gsconfirm::%{_u}%::snapshot} to {_snapshot}
    set {-gsconfirm::%{_u}%::token} to {_token}
    set {-gsconfirm::%{_u}%::inv} to {_p}.getOpenInventory().getTopInventory()

on InventoryClickEvent with priority highest:
    set {_e} to event
    set {_p} to {_e}.getWhoClicked()
    set {_u} to "%{_p}.getUniqueId()%"
    if {-gsconfirm::%{_u}%::inv} is set:
        if {_e}.getView().getTopInventory() is {-gsconfirm::%{_u}%::inv}:
            {_e}.setCancelled(true)
            "%{_e}.getClick().name()%" is "LEFT"
            if {_e}.getRawSlot() is 11:
                delete {-gsconfirm::%{_u}%::*}
                wait 1 tick
                {_p}.closeInventory()
                stop
            {_e}.getRawSlot() is 15
            {-gsconfirm::%{_u}%::busy} is not set
            set {-gsconfirm::%{_u}%::busy} to true
            set {_menu} to {-gsconfirm::%{_u}%::inv}
            wait 1 tick
            {_p}.isOnline() is true
            {-gsconfirm::%{_u}%::inv} is {_menu}
            {_p}.getOpenInventory().getTopInventory() is {_menu}
            set {_slot} to {-gsconfirm::%{_u}%::slot}
            set {_s} to {-gsconfirm::%{_u}%::serial}
            set {_snapshot} to {-gsconfirm::%{_u}%::snapshot}
            set {_token} to {-gsconfirm::%{_u}%::token}
            delete {-gsconfirm::%{_u}%::*}
            {_p}.closeInventory()
            set {_inv} to {_p}.getInventory()
            set {_helm} to {_inv}.getItem({_slot})
            if gsIsHelmet({_helm}) is not true:
                send "{@p} &cKeep the helmet in your inventory and try again." to {_p}
                stop
            if {_snapshot}.equals({_helm}) is not true:
                send "{@p} &7The helmet changed; drop the voucher onto it again." to {_p}
                stop
            if gsRedeemable({_s}, {_token}) is not true:
                send "{@p} &cThat serial is unknown or already redeemed." to {_p}
                stop
            loop 36 times:
                set {_n} to loop-number - 1
                if {_found} is not set:
                    set {_v} to {_inv}.getItem({_n})
                    if gsSerial({_v}) is {_s}:
                        if {_v}.getAmount() is 1:
                            if gsToken({_v}) is {_token}:
                                set {_found} to {_n}
            if {_found} is not set:
                send "{@p} &cThe skin is no longer in your inventory." to {_p}
                stop
            set {_m} to {_helm}.getItemMeta()
            set {_old} to {_m}.getPersistentDataContainer().get(gsKey("geass_skin"), PersistentDataType.STRING)
            gsSetLook({_m}, "geass")
            {_m}.getPersistentDataContainer().set(gsKey("geass_skin"), PersistentDataType.STRING, {_s})
            {_m}.getPersistentDataContainer().remove(gsKey("geass_token"))
            if {_s} is not "test":
                {_m}.getPersistentDataContainer().set(gsKey("geass_token"), PersistentDataType.STRING, {_token})
            {_helm}.setItemMeta({_m})
            set {_styled} to gsLore({_helm})
            if {_styled} is set:
                set {_helm} to {_styled}
            if {_s} is not "test":
                set {geass.state::%{_s}%} to "APPLIED"
                set {geass.log::%{_s}%} to "%{geass.log::%{_s}%}% | applied by %{_p}.getName()% %now%"
            if {_old} is set:
                if {_old} is not "test":
                    if {_old} is not {_s}:
                        set {geass.state::%{_old}%} to "REPLACED"
            {_inv}.setItem({_found}, null)
            {_inv}.setItem({_slot}, {_helm})
            {_p}.updateInventory()
            play sound "block.beacon.power_select" with volume 0.7 and pitch 1.6 to {_p}
            if {_s} is "test":
                send "{@p} &cTest copy &7applied. No serial used; the helmet's protection is intact." to {_p}
            else:
                send "{@p} &c#%{_s}% &7applied. The helmet's armour and enchants are intact." to {_p}
            send "[geass] #%{_s}% applied by %{_p}.getName()%" to console
            stop
    {_e}.isCancelled() is false
    set {_s} to gsSerial({_e}.getCursor())
    {_s} is set
    set {_helm} to {_e}.getCurrentItem()
    gsIsHelmet({_helm}) is true
    # Creative clients own their inventory: cancelling a creative click leaves the
    # client holding its own copy of the item (a dupe). Skins only apply in survival.
    if any:
        {_e}.getClass().getSimpleName() is "InventoryCreativeEvent"
        "%{_p}.getGameMode().name()%" is "CREATIVE"
    then:
        send "{@p} &7Switch to Survival to apply a skin." to {_p}
        stop
    {_e}.setCancelled(true)
    "%{_e}.getClick().name()%" is "LEFT"
    {_e}.getCursor().getAmount() is 1
    if {_e}.getClickedInventory() is not {_p}.getInventory():
        send "{@p} &7Move the helmet into your own inventory first." to {_p}
        stop
    if {_e}.getSlot() >= 36:
        send "{@p} &7Take the helmet off and drop the voucher onto it in your inventory." to {_p}
        stop
    if gsRedeemable({_s}, gsToken({_e}.getCursor())) is not true:
        send "{@p} &cThat serial is unknown or already redeemed." to {_p}
        stop
    if gsHasSpace({_p}) is not true:
        send "{@p} &7Free one inventory slot first." to {_p}
        stop
    set {_slot} to {_e}.getSlot()
    set {_snapshot} to {_helm}.clone()
    set {_voucher} to {_e}.getCursor().clone()
    set {_token} to gsToken({_voucher})
    {_e}.getView().setCursor(null)
    {_p}.getInventory().addItem({_voucher})
    wait 1 tick
    {_p}.isOnline() is true
    {_p}.updateInventory()
    gsOpen({_p}, {_slot}, {_s}, {_snapshot}, {_token})

on InventoryDragEvent:
    set {_u} to "%event.getWhoClicked().getUniqueId()%"
    {-gsconfirm::%{_u}%::inv} is set
    event.getView().getTopInventory() is {-gsconfirm::%{_u}%::inv}
    event.setCancelled(true)

on InventoryCloseEvent:
    set {_p} to event.getPlayer()
    set {_u} to "%{_p}.getUniqueId()%"
    if {-gsconfirm::%{_u}%::inv} is set:
        if event.getInventory() is {-gsconfirm::%{_u}%::inv}:
            delete {-gsconfirm::%{_u}%::*}
    wait 1 tick
    {_p}.isOnline() is true
    gsSyncInv({_p})

on quit:
    delete {-gsconfirm::%uuid of player%::*}
    delete {-gsmenu::%uuid of player%::*}
    delete {-gs.saywait::%uuid of player%}

on join:
    wait 1 second
    player is online
    gsSyncInv(player)

on join:
    {gs.possess-back::%uuid of player%} is set
    wait 1 tick
    player is online
    gsPossessEnd(player)

on unload:
    loop all players:
        if {-gs.possess::%uuid of loop-player%} is set:
            gsPossessEnd(loop-player)
    loop {-gs.fx::*}:
        if loop-value.isValid() is true:
            loop-value.remove()
    delete {-gs.fx::*}
    loop all players:
        gsHold(loop-player, false)
        loop-player.setSneaking(false)
        set {_u} to "%uuid of loop-player%"
        if {-gsmenu::%{_u}%::inv} is set:
            if loop-player.getOpenInventory().getTopInventory() is {-gsmenu::%{_u}%::inv}:
                loop-player.closeInventory()
        if {-gsconfirm::%{_u}%::inv} is set:
            if loop-player.getOpenInventory().getTopInventory() is {-gsconfirm::%{_u}%::inv}:
                loop-player.closeInventory()
    delete {-gsconfirm::*}
    delete {-gsmenu::*}

# the worn helmet: keep its line, and put a spent activation back to the resting sigil
every 10 ticks:
    loop all players:
        set {_inv} to loop-player.getInventory()
        set {_head} to gsLore({_inv}.getHelmet())
        if {_head} is set:
            {_inv}.setHelmet({_head})

# ------------------------ the Geass ------------------------

# Who may give orders with it (the skin itself is cosmetic for anyone else wearing it).
function gsCanCommand(p: player) :: boolean:
    if {_p}.isOp() is true:
        return true
    return {_p}.hasPermission("elytro.geass.command")

# Like C.C.: only a permission granted outright makes someone immune (ops aren't by default).
function gsImmune(t: player) :: boolean:
    if {_t}.isPermissionSet("elytro.geass.immune") is not true:
        return false
    return {_t}.hasPermission("elytro.geass.immune")

function gsFx(e: object):
    add {_e} to {-gs.fx::*}

function gsFxDone(e: object):
    remove {_e} from {-gs.fx::*}
    if {_e}.isValid() is true:
        {_e}.remove()

function gsSize(d: object, size: number, spin: number):
    {_d}.setTransformation(new Transformation(new Vector3f(), new Quaternionf().rotateZ({_spin}), new Vector3f({_size}, {_size}, {_size}), new Quaternionf()))

# A full-bright, camera-facing pack model (geass_sigil / geass_ring): the Geass's own particles.
function gsShow(at: object, model: text) :: object:
    set {_d} to {_at}.getWorld().spawn({_at}, ItemDisplay.class)
    gsFx({_d})
    {_d}.setPersistent(false)
    {_d}.setBillboard(GeassBillboard.CENTER)
    {_d}.setBrightness(new GeassBrightness(15, 15))
    {_d}.setViewRange(1.0)
    {_d}.setTeleportDuration(1)
    {_d}.setInterpolationDelay(0)
    {_d}.setInterpolationDuration(1)
    set {_item} to new ItemStack(Material.PAPER)
    set {_meta} to {_item}.getItemMeta()
    {_meta}.setItemModel(gsKey({_model}))
    {_item}.setItemMeta({_meta})
    {_d}.setItemStack({_item})
    gsSize({_d}, 0.05, 0)
    return {_d}

# The sigil bursts open right in front of the eye for a moment.
function gsBloom(at: object):
    set {_d} to gsShow({_at}, "geass_sigil")
    loop 7 times:
        wait 1 tick
        if {_d}.isValid() is not true:
            exit loop
        set {_n} to loop-number
        if {_n} <= 4:
            gsSize({_d}, 0.3 + 0.35 * {_n}, 0)
        else:
            gsSize({_d}, 1.7 - 0.5 * ({_n} - 4), 0)
    gsFxDone({_d})

# One sigil flies from the eye to `to`, spinning, swelling mid-flight and narrowing into the eyes.
function gsBolt(from: object, to: object, steps: number):
    set {_d} to gsShow({_from}, "geass_sigil")
    set {_w} to {_from}.getWorld()
    set {_red} to new GeassDust(Color.fromRGB(255, 30, 64), 0.9)
    set {_dark} to new GeassDust(Color.fromRGB(120, 0, 22), 0.6)
    set {_span} to {_to}.toVector().subtract({_from}.toVector())
    loop {_steps} times:
        wait 1 tick
        if {_d}.isValid() is not true:
            exit loop
        set {_t} to loop-number / {_steps}
        set {_at} to {_from}.clone().add({_span}.clone().multiply({_t}))
        {_d}.teleport({_at})
        gsSize({_d}, 0.3 + 0.8 * sin(180 * {_t}), {_t} * 6.283)
        {_w}.spawnParticle(Particle.DUST, {_at}, 3, 0.08, 0.08, 0.08, 0, {_red})
        {_w}.spawnParticle(Particle.DUST, {_at}, 2, 0.18, 0.18, 0.18, 0, {_dark})
    gsFxDone({_d})

# The eye fires: a bloom at the face and three sigils a couple of ticks apart.
function gsVolley(p: player, to: object):
    set {_eye} to {_p}.getEyeLocation()
    set {_dir} to {_eye}.getDirection()
    set {_right} to {_dir}.clone().crossProduct(new Vector(0, 1, 0))
    if {_right}.lengthSquared() < 0.001:
        set {_right} to new Vector(1, 0, 0)
    # out of the left eye, where the sigil sits
    set {_from} to {_eye}.clone().add({_dir}.clone().multiply(0.7)).subtract({_right}.normalize().multiply(0.09))
    gsBloom({_eye}.clone().add({_dir}.clone().multiply(1.1)))
    set {_steps} to max(5, min(12, round({_from}.distance({_to}) / 2)))
    loop 3 times:
        gsBolt({_from}, {_to}, {_steps})
        wait 2 ticks

# Their eyes take the ring: it closes over their face, and the order hangs above their head.
function gsMark(target: object, words: text):
    set {_w} to {_target}.getWorld()
    set {_ring} to gsShow({_target}.getEyeLocation(), "geass_ring")
    set {_dust} to new GeassDust(Color.fromRGB(255, 30, 64), 0.8)
    if {_words} is not "":
        set {_text} to {_w}.spawn({_target}.getEyeLocation().add(0, 0.8, 0), TextDisplay.class)
        gsFx({_text})
        {_text}.setPersistent(false)
        {_text}.setBillboard(GeassBillboard.CENTER)
        {_text}.setBackgroundColor(Color.fromARGB(0, 0, 0, 0))
        {_text}.setShadowed(true)
        {_text}.setBrightness(new GeassBrightness(15, 15))
        {_text}.setTeleportDuration(2)
        {_text}.text(MiniMessage.miniMessage().deserialize("<#ff1e40><bold><italic>%{_words}%"))
    loop 44 times:
        wait 1 tick
        if {_target}.isValid() is not true:
            exit loop
        set {_n} to loop-number
        set {_eye} to {_target}.getEyeLocation()
        if {_ring}.isValid() is true:
            {_ring}.teleport({_eye}.clone().add({_eye}.getDirection().multiply(0.34)))
            if {_n} <= 6:
                gsSize({_ring}, 0.15 + 0.12 * {_n}, {_n} * 0.3)
            else if {_n} >= 36:
                gsSize({_ring}, 0.87 * (44 - {_n}) / 8, {_n} * 0.06)
            else:
                gsSize({_ring}, 0.82 + 0.05 * sin({_n} * 40), {_n} * 0.06)
        if {_text} is set:
            if {_text}.isValid() is true:
                {_text}.teleport({_eye}.clone().add(0, 0.8 + {_n} * 0.006, 0))
        if mod({_n}, 4) is 0:
            loop 12 times:
                set {_a} to loop-number-2 * 30 + {_n} * 9
                {_w}.spawnParticle(Particle.DUST, {_eye}.clone().add(0.5 * cos({_a}), 0.1, 0.5 * sin({_a})), 1, 0, 0, 0, 0, {_dust})
    gsFxDone({_ring})
    if {_text} is set:
        gsFxDone({_text})

# Is this helmet in Zero's mask mode?
function gsZero(i: object) :: boolean:
    if {_i} is not set:
        return false
    if {_i}.hasItemMeta() is not true:
        return false
    return {_i}.getItemMeta().getPersistentDataContainer().has(gsKey("geass_zero"), PersistentDataType.STRING)

# Step the worn Zero mask's eye shutter: "closed", "o1", "o2" or "open".
function gsShutter(p: player, frame: text):
    set {_helm} to {_p}.getInventory().getHelmet()
    if gsZero({_helm}) is not true:
        stop
    set {_m} to {_helm}.getItemMeta()
    gsFrame({_m}, {_frame})
    {_helm}.setItemMeta({_m})
    {_p}.getInventory().setHelmet({_helm})

# The eye itself: the winged sigil and the red screen for a few seconds, and the sound.
function gsFlare(p: player):
    set {_helm} to {_p}.getInventory().getHelmet()
    set {_now} to Bukkit.getServer().getWorlds().get(0).getGameTime()
    set {_m} to {_helm}.getItemMeta()
    gsSetLook({_m}, "geass_active")
    set {_until} to {_now} + {@lit} * 20
    {_m}.getPersistentDataContainer().set(gsKey("geass_lit"), PersistentDataType.STRING, "%floor({_until})%")
    {_helm}.setItemMeta({_m})
    {_p}.getInventory().setHelmet({_helm})
    play sound "block.beacon.activate" with volume 0.8 and pitch 1.8 at {_p}
    play sound "entity.illusioner.cast_spell" with volume 0.9 and pitch 1.3 at {_p}
    play sound "item.trident.thunder" with volume 0.25 and pitch 1.9 at {_p}
    play sound "entity.evoker.prepare_attack" with volume 0.5 and pitch 1.7 at {_p}

# Ticks from gsFire until the sigils land in someone's eyes (the mask's shutter opens first).
function gsFireDelay(p: player) :: number:
    if gsZero({_p}.getInventory().getHelmet()) is true:
        return 12
    return 9

# Open the eye and fire at `to`. With Zero's mask on, the shutter slides open first and closes
# again when the Geass dims.
function gsFire(p: player, to: object):
    set {_zero} to gsZero({_p}.getInventory().getHelmet())
    if {_zero} is true:
        play sound "block.piston.contract" with volume 0.4 and pitch 1.9 at {_p}
        play sound "block.iron_trapdoor.open" with volume 0.5 and pitch 1.6 at {_p}
        gsShutter({_p}, "o1")
        wait 1 tick
        gsShutter({_p}, "o2")
        wait 1 tick
    gsFlare({_p})
    if {_zero} is true:
        wait 1 tick
    gsVolley({_p}, {_to})
    if {_zero} is not true:
        stop
    set {_hold} to {@lit} * 20 - 6
    wait ("%{_hold}% ticks" parsed as timespan)
    if {_p}.isOnline() is not true:
        stop
    if gsZero({_p}.getInventory().getHelmet()) is not true:
        stop
    play sound "block.iron_trapdoor.close" with volume 0.5 and pitch 1.6 at {_p}
    gsShutter({_p}, "o2")
    wait 2 ticks
    gsShutter({_p}, "o1")
    wait 2 ticks
    set {_helm} to {_p}.getInventory().getHelmet()
    if gsZero({_helm}) is not true:
        stop
    set {_m} to {_helm}.getItemMeta()
    {_m}.getPersistentDataContainer().remove(gsKey("geass_lit"))
    gsSetLook({_m}, "geass")
    {_helm}.setItemMeta({_m})
    {_p}.getInventory().setHelmet({_helm})

# Cooldown check-and-set. False (and nothing set) while it's still recharging.
function gsReady(p: player) :: boolean:
    set {_u} to "%uuid of {_p}%"
    set {_now} to Bukkit.getServer().getWorlds().get(0).getGameTime()
    if {-gs.ready::%{_u}%} is set:
        if {-gs.ready::%{_u}%} > {_now}:
            set {_left} to ceil(({-gs.ready::%{_u}%} - {_now}) / 20)
            {_p}.sendActionBar(MiniMessage.miniMessage().deserialize("<dark_red>The Geass recovers... <gray>%{_left}%s"))
            return false
    set {-gs.ready::%{_u}%} to {_now} + {@cooldown} * 20
    return true

# Someone you can lock eyes with right now (not yourself, vanished staff or spectators).
function gsTarget(p: player) :: object:
    set {_t} to {_p}.getTargetEntity(24)
    {_t} is set
    {_t}.isValid() is true
    if {_t} is a player:
        {_t}.hasMetadata("vanished") is false
        "%{_t}.getGameMode().name()%" is not "SPECTATOR"
    return {_t}

function gsActivate(p: player):
    set {_u} to "%uuid of {_p}%"
    if {-gs.possess::%{_u}%} is set:
        stop
    set {_helm} to {_p}.getInventory().getHelmet()
    set {_s} to gsWorn({_helm})
    if {_s} is not set:
        send "{@p} &7Wear a helmet with the Geass first." to {_p}
        stop
    set {_target} to gsTarget({_p})
    if {_target} is set:
        if {_target} is a player:
            if gsCanCommand({_p}) is true:
                gsMenu({_p}, {_target})
                stop
    if gsReady({_p}) is not true:
        stop
    # nobody to command: the Geass still fires, at whatever you're looking at
    if {_target} is set:
        set {_to} to {_target}.getLocation().add(0, {_target}.getHeight() * 0.85, 0)
    else:
        set {_block} to {_p}.getTargetBlockExact(20)
        if {_block} is set:
            set {_to} to {_block}.getLocation().add(0.5, 0.5, 0.5)
        else:
            set {_to} to {_p}.getEyeLocation().add({_p}.getEyeLocation().getDirection().multiply(16))
    set {_delay} to gsFireDelay({_p})
    gsFire({_p}, {_to})
    if {_target} is not set:
        stop
    if LivingEntity.class.isInstance({_target}) is not true:
        stop
    wait ("%{_delay}% ticks" parsed as timespan)
    if {_target}.isValid() is not true:
        stop
    gsMark({_target}, "")

# ------------------------ commands ------------------------

function gsCmdName(id: text) :: text:
    if {_id} is "say":
        return "Speak"
    if {_id} is "hail":
        return "All hail me"
    if {_id} is "kneel":
        return "Kneel"
    if {_id} is "look":
        return "Look at me"
    if {_id} is "follow":
        return "Follow me"
    if {_id} is "leap":
        return "Leap"
    if {_id} is "spin":
        return "Spin"
    if {_id} is "run":
        return "Run"
    if {_id} is "still":
        return "Do not move"
    if {_id} is "dance":
        return "Dance"
    if {_id} is "fly":
        return "Rise"
    if {_id} is "sleep":
        return "Sleep"
    if {_id} is "forget":
        return "Forget"
    if {_id} is "live":
        return "Live"
    if {_id} is "fight":
        return "Fight for me"
    return "Obey"

function gsCmdIcon(id: text) :: text:
    if {_id} is "say":
        return "WRITABLE_BOOK"
    if {_id} is "hail":
        return "GOLDEN_HELMET"
    if {_id} is "kneel":
        return "RED_CARPET"
    if {_id} is "look":
        return "ENDER_EYE"
    if {_id} is "follow":
        return "LEAD"
    if {_id} is "leap":
        return "SLIME_BALL"
    if {_id} is "spin":
        return "CLOCK"
    if {_id} is "run":
        return "SUGAR"
    if {_id} is "still":
        return "ICE"
    if {_id} is "dance":
        return "NOTE_BLOCK"
    if {_id} is "fly":
        return "FEATHER"
    if {_id} is "sleep":
        return "RED_BED"
    if {_id} is "forget":
        return "INK_SAC"
    if {_id} is "live":
        return "GOLDEN_APPLE"
    if {_id} is "fight":
        return "IRON_SWORD"
    return "ECHO_SHARD"

function gsCmdDesc(id: text, caster: text) :: text:
    if {_id} is "say":
        return "Type it in chat; they say it as themselves."
    if {_id} is "hail":
        return "They say ""All hail %{_caster}%!"" in chat."
    if {_id} is "kneel":
        return "They crouch, eyes to the ground."
    if {_id} is "look":
        return "Their gaze locks onto you."
    if {_id} is "follow":
        return "They walk after you for 12s."
    if {_id} is "leap":
        return "They jump high into the air."
    if {_id} is "spin":
        return "They turn round and round."
    if {_id} is "run":
        return "They bolt away from you."
    if {_id} is "still":
        return "They can't walk or jump for 4s."
    if {_id} is "dance":
        return "They bob, hop and turn."
    if {_id} is "fly":
        return "They float up, then drift down."
    if {_id} is "sleep":
        return "They lie down and black out for 5s."
    if {_id} is "forget":
        return "Their vision blurs; they lose the moment."
    if {_id} is "live":
        return "Regeneration and absorption for 10s."
    if {_id} is "fight":
        return "For 10s they attack anyone near them (PvP rules still apply)."
    return "Take their body for 10s: W/S walk, A/D turn, space jumps, type to talk through them, sneak to let go."

function gsMenu(p: player, t: player):
    set {_u} to "%uuid of {_p}%"
    set {_inv} to chest inventory with 5 rows named "&4&lGeass &8» &7%{_t}.getName()%"
    set {_pane} to black stained glass pane named " "
    loop 45 times:
        set slot (loop-number - 1) of {_inv} to {_pane}
    set {_head} to new ItemStack(Material.PLAYER_HEAD)
    set {_hm} to {_head}.getItemMeta()
    {_hm}.setOwningPlayer({_t})
    {_head}.setItemMeta({_hm})
    set name of {_head} to "&c%{_t}.getName()%"
    set lore of {_head} to "&7Their eyes meet yours.", "&7Choose what they must obey."
    set slot 4 of {_inv} to {_head}
    open {_inv} to {_p}
    set {-gsmenu::%{_u}%::inv} to {_p}.getOpenInventory().getTopInventory()
    set {-gsmenu::%{_u}%::target} to "%uuid of {_t}%"
    set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, 25, 30 and 32
    set {_ids::*} to "say", "hail", "kneel", "look", "follow", "leap", "spin", "run", "still", "dance", "fly", "sleep", "forget", "live", "fight" and "possess"
    loop 16 times:
        set {_id} to {_ids::%loop-number%}
        set {_slot} to {_slots::%loop-number%}
        set {_i} to new ItemStack(Material.valueOf(gsCmdIcon({_id})))
        set {_title} to "&c&l%gsCmdName({_id})%"
        if {_id} is "fight" or "possess":
            set {_title} to "&4&l%gsCmdName({_id})%"
        set name of {_i} to {_title}
        set lore of {_i} to "&7%gsCmdDesc({_id}, {_p}.getName())%", "", "&eClick &7to command."
        {_inv}.setItem({_slot}, {_i})
        set {-gsmenu::%{_u}%::slot::%{_slot}%} to {_id}
    set slot 40 of {_inv} to barrier named "&7Close" with lore "&8Let them be... for now."

on InventoryClickEvent with priority highest:
    set {_e} to event
    set {_p} to {_e}.getWhoClicked()
    set {_u} to "%{_p}.getUniqueId()%"
    {-gsmenu::%{_u}%::inv} is set
    {_e}.getView().getTopInventory() is {-gsmenu::%{_u}%::inv}
    {_e}.setCancelled(true)
    set {_raw} to {_e}.getRawSlot()
    if {_raw} is 40:
        delete {-gsmenu::%{_u}%::*}
        wait 1 tick
        {_p}.closeInventory()
        stop
    set {_id} to {-gsmenu::%{_u}%::slot::%{_raw}%}
    {_id} is set
    set {_tid} to {-gsmenu::%{_u}%::target}
    delete {-gsmenu::%{_u}%::*}
    wait 1 tick
    {_p}.closeInventory()
    {_p}.isOnline() is true
    set {_t} to Bukkit.getPlayer(UUID.fromString({_tid}))
    if {_id} is "say":
        if {_t} is not set:
            stop
        set {-gs.saywait::%{_u}%} to {_tid}
        set {-gs.saywait-at::%{_u}%} to now
        send "{@p} &7Type what &c%{_t}.getName()% &7must say. &8(30s, or type &7cancel&8)" to {_p}
        stop
    gsCommand({_p}, {_t}, {_id}, "")

on InventoryCloseEvent:
    set {_u} to "%event.getPlayer().getUniqueId()%"
    {-gsmenu::%{_u}%::inv} is set
    event.getInventory() is {-gsmenu::%{_u}%::inv}
    delete {-gsmenu::%{_u}%::*}

# Chat: the line you type for "Speak", and everything you say while inside someone's head.
on chat with priority lowest:
    set {_p} to player
    set {_u} to "%uuid of {_p}%"
    if {-gs.possess::%{_u}%} is set:
        cancel event
        set {_t} to {-gs.possess::%{_u}%}
        set {_msg} to message
        wait 1 tick
        gsForceSay({_t}, {_msg})
        stop
    {-gs.saywait::%{_u}%} is set
    set {_tid} to {-gs.saywait::%{_u}%}
    set {_at} to {-gs.saywait-at::%{_u}%}
    delete {-gs.saywait::%{_u}%}
    delete {-gs.saywait-at::%{_u}%}
    difference between {_at} and now is less than 30 seconds
    cancel event
    set {_msg} to message
    wait 1 tick
    if {_msg} is "cancel":
        send "{@p} &7Never mind." to {_p}
        stop
    gsCommand({_p}, Bukkit.getPlayer(UUID.fromString({_tid})), "say", {_msg})

# Say something as them. Never a command: leading slashes are dropped.
function gsForceSay(t: object, msg: text):
    if {_t} is not set:
        stop
    if {_t}.isOnline() is not true:
        stop
    set {_m} to {_msg}
    loop 5 times:
        if {_m} starts with "/":
            set {_m} to subtext of {_m} from characters 2 to length of {_m}
    if length of {_m} > 200:
        set {_m} to first 200 characters of {_m}
    if {_m} is "":
        stop
    make {_t} say {_m}

function gsCommand(p: player, t: object, id: text, arg: text):
    set {_u} to "%uuid of {_p}%"
    if {-gs.possess::%{_u}%} is set:
        send "{@p} &7You're already inside someone's mind." to {_p}
        stop
    if gsWorn({_p}.getInventory().getHelmet()) is not set:
        send "{@p} &7Wear the Geass to give orders." to {_p}
        stop
    if {_t} is not set:
        send "{@p} &7They're gone." to {_p}
        stop
    if {_t}.isOnline() is not true:
        send "{@p} &7They're gone." to {_p}
        stop
    if {_t}.getWorld() is not {_p}.getWorld():
        send "{@p} &7They're out of sight." to {_p}
        stop
    if {_t}.getLocation().distance({_p}.getLocation()) > 32:
        send "{@p} &7They're too far away now." to {_p}
        stop
    if gsReady({_p}) is not true:
        stop
    set {_name} to {_t}.getName()
    set {_delay} to gsFireDelay({_p})
    gsFire({_p}, {_t}.getEyeLocation())
    {_p}.sendActionBar(MiniMessage.miniMessage().deserialize("<dark_red>✦ <gray>You command <red>%{_name}%</red>: <white>%gsCmdName({_id})%"))
    send "[geass] %{_p}.getName()% commanded %{_name}%: %{_id}% %{_arg}%" to console
    wait ("%{_delay}% ticks" parsed as timespan)
    if {_t}.isOnline() is not true:
        stop
    if {_t}.getWorld() is not {_p}.getWorld():
        stop
    if gsImmune({_t}) is true:
        play sound "block.amethyst_block.resonate" with volume 1 and pitch 0.6 at {_t}
        send "{@p} &d%{_name}% &7meets your eyes... and smiles. &8The Geass has no power over them." to {_p}
        stop
    gsMark({_t}, "%gsCmdName({_id})%.")
    play sound "block.beacon.power_select" with volume 0.8 and pitch 1.9 to {_t}
    play sound "entity.illusioner.mirror_move" with volume 0.8 and pitch 1.2 to {_t}
    gsObey({_p}, {_t}, {_id}, {_arg})

# A point `dist` blocks from the target in the direction of yaw `a` (degrees), at height `dy`.
function gsAround(t: player, a: number, dist: number, dy: number) :: object:
    return {_t}.getLocation().add(-1 * {_dist} * sin({_a}), {_dy}, {_dist} * cos({_a}))

function gsLook(t: player, at: object):
    {_t}.lookAt({_at}.getX(), {_at}.getY(), {_at}.getZ(), LookAnchor.EYES)

# Walk them toward `at` (only on the ground, so falls and jumps keep their own physics).
function gsWalk(t: player, at: object, speed: number):
    if {_t}.isOnGround() is not true:
        stop
    set {_v} to {_at}.toVector().subtract({_t}.getLocation().toVector()).setY(0)
    if {_v}.lengthSquared() < 0.01:
        stop
    {_t}.setVelocity({_v}.normalize().multiply({_speed}))

# Freeze with transient attribute modifiers: never saved, so a quit or restart can't leave them.
function gsHold(t: player, on: boolean):
    set {_attrs::*} to {_t}.getAttribute(Attribute.MOVEMENT_SPEED) and {_t}.getAttribute(Attribute.JUMP_STRENGTH)
    loop {_attrs::*}:
        set {_a} to loop-value
        if {_a}.getModifier(gsKey("geass_still")) is set:
            {_a}.removeModifier(gsKey("geass_still"))
        if {_on} is true:
            {_a}.addTransientModifier(new AttributeModifier(gsKey("geass_still"), -1, GeassOp.MULTIPLY_SCALAR_1, EquipmentSlotGroup.ANY))

# Who they'd swing at: the nearest other player (survival/adventure, not hidden) or monster.
function gsFoe(p: player, t: player) :: object:
    set {_best} to 999
    loop ...{_t}.getNearbyEntities(12, 6, 12):
        set {_e} to loop-value
        set {_ok} to false
        if {_e} is a player:
            if {_e} is not {_p}:
                if {_e}.hasMetadata("vanished") is false:
                    if "%{_e}.getGameMode().name()%" is "SURVIVAL" or "ADVENTURE":
                        set {_ok} to true
        else if Monster.class.isInstance({_e}) is true:
            set {_ok} to true
        if {_ok} is true:
            set {_d} to {_e}.getLocation().distance({_t}.getLocation())
            if {_d} < {_best}:
                set {_best} to {_d}
                set {_foe} to {_e}
    return {_foe}

function gsObey(p: player, t: player, id: text, arg: text):
    if {_id} is "say":
        gsForceSay({_t}, {_arg})
    else if {_id} is "hail":
        gsForceSay({_t}, "All hail %{_p}.getName()%!")
    else if {_id} is "kneel":
        {_t}.addPotionEffect(new PotionEffect(PotionEffectType.SLOWNESS, 70, 6, true, false, false))
        loop 14 times:
            if {_t}.isOnline() is not true:
                stop
            {_t}.setSneaking(true)
            gsLook({_t}, gsAround({_t}, {_t}.getYaw(), 1.2, 0))
            wait 5 ticks
        {_t}.setSneaking(false)
    else if {_id} is "look":
        loop 12 times:
            if {_t}.isOnline() is not true:
                stop
            if {_p}.isOnline() is not true:
                stop
            if {_t}.getWorld() is not {_p}.getWorld():
                stop
            gsLook({_t}, {_p}.getEyeLocation())
            wait 4 ticks
    else if {_id} is "follow":
        loop 120 times:
            if {_t}.isOnline() is not true:
                stop
            if {_p}.isOnline() is not true:
                stop
            if {_t}.getWorld() is not {_p}.getWorld():
                stop
            if mod(loop-number, 2) is 0:
                gsLook({_t}, {_p}.getEyeLocation())
            if {_t}.getLocation().distance({_p}.getLocation()) > 2.6:
                gsWalk({_t}, {_p}.getLocation(), 0.27)
            wait 2 ticks
    else if {_id} is "leap":
        {_t}.setVelocity(new Vector(0, 1.15, 0))
        {_t}.getWorld().spawnParticle(Particle.CLOUD, {_t}.getLocation(), 12, 0.3, 0.05, 0.3, 0.05)
        play sound "entity.breeze.jump" with volume 1 and pitch 1.2 at {_t}
    else if {_id} is "spin":
        set {_yaw} to {_t}.getYaw()
        loop 24 times:
            if {_t}.isOnline() is not true:
                stop
            add 30 to {_yaw}
            gsLook({_t}, gsAround({_t}, {_yaw}, 3, 1.62))
            wait 2 ticks
    else if {_id} is "run":
        set {_away} to {_t}.getLocation().toVector().subtract({_p}.getLocation().toVector()).setY(0)
        if {_away}.lengthSquared() < 0.01:
            set {_away} to {_t}.getLocation().getDirection().setY(0)
        set {_away} to {_away}.normalize()
        gsLook({_t}, {_t}.getEyeLocation().add({_away}.clone().multiply(5)))
        {_t}.setVelocity({_away}.clone().multiply(1.1).setY(0.35))
        {_t}.addPotionEffect(new PotionEffect(PotionEffectType.SPEED, 120, 3, true, false, false))
    else if {_id} is "still":
        gsHold({_t}, true)
        set {_chain} to new GeassDust(Color.fromRGB(150, 0, 26), 0.7)
        loop 8 times:
            if {_t}.isOnline() is not true:
                stop
            loop 10 times:
                set {_a} to loop-number-2 * 36
                {_t}.getWorld().spawnParticle(Particle.DUST, {_t}.getLocation().add(0.6 * cos({_a}), 0.15, 0.6 * sin({_a})), 1, 0, 0, 0, 0, {_chain})
            wait 10 ticks
        gsHold({_t}, false)
    else if {_id} is "dance":
        set {_yaw} to {_t}.getYaw()
        loop 16 times:
            if {_t}.isOnline() is not true:
                stop
            set {_n} to loop-number
            if mod({_n}, 2) is 0:
                {_t}.setSneaking(true)
            else:
                {_t}.setSneaking(false)
            if mod({_n}, 4) is 0:
                add 90 to {_yaw}
                gsLook({_t}, gsAround({_t}, {_yaw}, 3, 1.62))
                {_t}.setVelocity(new Vector(0, 0.38, 0))
            {_t}.getWorld().spawnParticle(Particle.NOTE, {_t}.getLocation().add(0, 2.3, 0), 1, 0.3, 0.1, 0.3, 1)
            wait 3 ticks
        {_t}.setSneaking(false)
    else if {_id} is "fly":
        {_t}.addPotionEffect(new PotionEffect(PotionEffectType.LEVITATION, 50, 1, true, false, false))
        {_t}.addPotionEffect(new PotionEffect(PotionEffectType.SLOW_FALLING, 200, 0, true, false, false))
        play sound "entity.phantom.flap" with volume 0.8 and pitch 1.4 at {_t}
        loop 10 times:
            if {_t}.isOnline() is not true:
                stop
            {_t}.getWorld().spawnParticle(Particle.END_ROD, {_t}.getLocation(), 3, 0.25, 0.1, 0.25, 0.01)
            wait 5 ticks
    else if {_id} is "sleep":
        {_t}.setPose(Pose.SLEEPING, true)
        {_t}.addPotionEffect(new PotionEffect(PotionEffectType.BLINDNESS, 110, 0, true, false, false))
        {_t}.addPotionEffect(new PotionEffect(PotionEffectType.SLOWNESS, 100, 6, true, false, false))
        play sound "entity.player.breath" with volume 0.6 and pitch 0.7 at {_t}
        loop 10 times:
            if {_t}.isOnline() is not true:
                stop
            {_t}.getWorld().spawnParticle(Particle.CLOUD, {_t}.getLocation().add(0, 0.6, 0), 1, 0.2, 0.05, 0.2, 0.01)
            wait 10 ticks
        {_t}.setPose(Pose.STANDING, false)
    else if {_id} is "forget":
        {_t}.addPotionEffect(new PotionEffect(PotionEffectType.BLINDNESS, 50, 0, true, false, false))
        {_t}.addPotionEffect(new PotionEffect(PotionEffectType.NAUSEA, 120, 0, true, false, false))
        wait 60 ticks
        if {_t}.isOnline() is not true:
            stop
        send "&7&o...huh? What was I just doing?" to {_t}
    else if {_id} is "live":
        {_t}.addPotionEffect(new PotionEffect(PotionEffectType.REGENERATION, 200, 1, true, false, true))
        {_t}.addPotionEffect(new PotionEffect(PotionEffectType.ABSORPTION, 200, 1, true, false, true))
        {_t}.getWorld().spawnParticle(Particle.HEART, {_t}.getLocation().add(0, 1.2, 0), 8, 0.4, 0.4, 0.4, 0)
        play sound "block.amethyst_block.chime" with volume 1 and pitch 0.8 at {_t}
    else if {_id} is "fight":
        gsFight({_p}, {_t})
    else if {_id} is "possess":
        gsPossess({_p}, {_t})

# For 10s they go for whoever is nearest (other players or monsters, never you). Real attacks,
# so region PvP rules decide whether they land.
function gsFight(p: player, t: player):
    set {_aura} to new GeassDust(Color.fromRGB(200, 0, 30), 1.0)
    set {_swing} to 0
    loop 50 times:
        if {_t}.isOnline() is not true:
            stop
        if {_t}.isDead() is true:
            stop
        {_t}.getWorld().spawnParticle(Particle.DUST, {_t}.getLocation().add(0, 0.2, 0), 6, 0.35, 0.05, 0.35, 0, {_aura})
        set {_foe} to gsFoe({_p}, {_t})
        if {_foe} is not set:
            if {_told} is not set:
                set {_told} to true
                {_p}.sendActionBar(MiniMessage.miniMessage().deserialize("<gray>There's no one near %{_t}.getName()% to fight."))
        else:
            gsLook({_t}, {_foe}.getEyeLocation())
            add 1 to {_swing}
            if {_foe}.getLocation().distance({_t}.getLocation()) > 2.8:
                gsWalk({_t}, {_foe}.getLocation(), 0.34)
            else if {_swing} >= 3:
                set {_swing} to 0
                {_t}.swingMainHand()
                {_t}.attack({_foe})
        wait 4 ticks

# Take their body for 10s. You watch through their eyes (spectator camera on them); your keys
# drive them: W/S walk, A/D turn, space jumps, sprint runs. Chat goes out as them. Sneak (which
# leaves the spectator camera) lets go early. You're put back where you stood, in your own mode.
function gsPossess(p: player, t: player):
    set {_u} to "%uuid of {_p}%"
    if {-gs.possess::%{_u}%} is set:
        stop
    set {gs.possess-back::%{_u}%} to {_p}.getLocation()
    set {gs.possess-mode::%{_u}%} to "%{_p}.getGameMode().name()%"
    set {-gs.possess::%{_u}%} to {_t}
    {_p}.setGameMode(GameMode.SPECTATOR)
    {_p}.teleport({_t}.getLocation())
    wait 2 ticks
    if {_p}.isOnline() is not true:
        stop
    {_p}.setSpectatorTarget({_t})
    play sound "entity.warden.sonic_charge" with volume 0.6 and pitch 1.8 to {_p}
    set {_yaw} to {_t}.getYaw()
    set {_eyes} to new GeassDust(Color.fromRGB(255, 30, 64), 0.6)
    loop 200 times:
        wait 1 tick
        if {_p}.isOnline() is not true:
            exit loop
        if {_t}.isOnline() is not true:
            exit loop
        if {_t}.isDead() is true:
            exit loop
        if {_p}.getSpectatorTarget() is not {_t}:
            exit loop
        set {_n} to loop-number
        set {_in} to {_p}.getCurrentInput()
        if {_in}.isLeft() is true:
            subtract 9 from {_yaw}
        if {_in}.isRight() is true:
            add 9 to {_yaw}
        gsLook({_t}, gsAround({_t}, {_yaw}, 4, 1.3))
        set {_dir} to new Vector(-1 * sin({_yaw}), 0, cos({_yaw}))
        if {_t}.isOnGround() is true:
            set {_speed} to 0
            if {_in}.isForward() is true:
                set {_speed} to 0.24
                if {_in}.isSprint() is true:
                    set {_speed} to 0.34
            else if {_in}.isBackward() is true:
                set {_speed} to -0.16
            set {_v} to {_dir}.clone().multiply({_speed})
            if {_in}.isJump() is true:
                {_v}.setY(0.42)
            if {_speed} is not 0:
                {_t}.setVelocity({_v})
            else if {_in}.isJump() is true:
                {_t}.setVelocity({_v})
        if mod({_n}, 5) is 0:
            {_t}.getWorld().spawnParticle(Particle.DUST, {_t}.getEyeLocation().add(0, 0.35, 0), 3, 0.2, 0.1, 0.2, 0, {_eyes})
        if mod({_n}, 10) is 1:
            {_p}.sendActionBar(MiniMessage.miniMessage().deserialize("<dark_red>✦ <gray>Inside <red>%{_t}.getName()%</red> <dark_gray>| <gray>W/S walk, A/D turn, chat speaks, sneak to let go <dark_gray>| <white>%ceil((200 - {_n}) / 20)%s"))
    gsPossessEnd({_p})

function gsPossessEnd(p: player):
    set {_u} to "%uuid of {_p}%"
    delete {-gs.possess::%{_u}%}
    if {_p}.isOnline() is not true:
        stop
    if {gs.possess-back::%{_u}%} is not set:
        stop
    if {_p}.getSpectatorTarget() is set:
        {_p}.setSpectatorTarget(null)
    {_p}.teleport({gs.possess-back::%{_u}%})
    {_p}.setGameMode(GameMode.valueOf({gs.possess-mode::%{_u}%}))
    delete {gs.possess-back::%{_u}%}
    delete {gs.possess-mode::%{_u}%}
    play sound "entity.warden.sonic_charge" with volume 0.4 and pitch 0.6 to {_p}

# ------------------------ Zero's outfit ------------------------

function zrCan(p: player) :: boolean:
    if {_p}.isOp() is true:
        return true
    return {_p}.hasPermission("elytro.geass.zero")

# Dress one armour piece in Zero's look (the suit / trousers / boots, and the cloak on the chest),
# remembering its own look. Returns the changed item.
function zrDress(i: object, slot: text) :: object:
    set {_m} to {_i}.getItemMeta()
    if {_m}.getPersistentDataContainer().has(gsKey("zero_prev"), PersistentDataType.STRING) is not true:
        set {_was} to "none"
        if {_m}.hasEquippable() is true:
            if {_m}.getEquippable().getModel() is set:
                set {_was} to "%{_m}.getEquippable().getModel()%"
        {_m}.getPersistentDataContainer().set(gsKey("zero_prev"), PersistentDataType.STRING, {_was})
    set {_eq} to {_m}.getEquippable()
    {_eq}.setSlot(EquipmentSlot.valueOf({_slot}))
    {_eq}.setModel(gsKey("zero"))
    {_m}.setEquippable({_eq})
    {_i}.setItemMeta({_m})
    return {_i}

# Undo zrDress. Returns the item, or nothing when it was a piece /zero made up (it goes away).
function zrUndress(i: object) :: object:
    if zrIsEmpty({_i}) is true:
        return {_i}
    if {_i}.hasItemMeta() is not true:
        return {_i}
    set {_m} to {_i}.getItemMeta()
    if {_m}.getPersistentDataContainer().has(gsKey("zero_spawned"), PersistentDataType.STRING) is true:
        return {_none}
    set {_prev} to {_m}.getPersistentDataContainer().get(gsKey("zero_prev"), PersistentDataType.STRING)
    if {_prev} is not set:
        return {_i}
    if {_prev} is "none":
        {_m}.setEquippable(null)
    else:
        set {_eq} to {_m}.getEquippable()
        {_eq}.setModel(NamespacedKey.fromString({_prev}))
        {_m}.setEquippable({_eq})
    {_m}.getPersistentDataContainer().remove(gsKey("zero_prev"))
    {_i}.setItemMeta({_m})
    return {_i}

function zrSpawned(mat: text, name: text) :: object:
    set {_i} to new ItemStack(Material.valueOf({_mat}))
    set {_m} to {_i}.getItemMeta()
    {_m}.getPersistentDataContainer().set(gsKey("zero_spawned"), PersistentDataType.STRING, "1")
    {_m}.setUnbreakable(true)
    {_i}.setItemMeta({_m})
    set name of {_i} to {_name}
    return {_i}

function zrIsEmpty(i: object) :: boolean:
    if {_i} is not set:
        return true
    return {_i}.getType().isAir()

function zrOn(p: player):
    set {_inv} to {_p}.getInventory()
    set {_h} to {_inv}.getHelmet()
    if zrIsEmpty({_h}) is true:
        set {_h} to zrSpawned("LEATHER_HELMET", "&5&lZero's Mask")
    if gsIsHelmet({_h}) is not true:
        send "{@p} &7Take what's on your head off first (Zero's mask needs a helmet slot)." to {_p}
        stop
    set {_m} to {_h}.getItemMeta()
    if gsWorn({_h}) is not set:
        # the mask carries the Geass: a test copy if this helmet has none of its own
        {_m}.getPersistentDataContainer().set(gsKey("geass_skin"), PersistentDataType.STRING, "test")
        {_m}.getPersistentDataContainer().set(gsKey("zero_gsauto"), PersistentDataType.STRING, "1")
    {_m}.getPersistentDataContainer().set(gsKey("geass_zero"), PersistentDataType.STRING, "1")
    {_m}.getPersistentDataContainer().remove(gsKey("geass_lit"))
    gsSetLook({_m}, "geass")
    {_h}.setItemMeta({_m})
    set {_styled} to gsLore({_h})
    if {_styled} is set:
        set {_h} to {_styled}
    {_inv}.setHelmet({_h})
    set {_c} to {_inv}.getChestplate()
    if zrIsEmpty({_c}) is true:
        set {_c} to zrSpawned("LEATHER_CHESTPLATE", "&5&lZero's Coat")
    {_inv}.setChestplate(zrDress({_c}, "CHEST"))
    set {_l} to {_inv}.getLeggings()
    if zrIsEmpty({_l}) is true:
        set {_l} to zrSpawned("LEATHER_LEGGINGS", "&5&lZero's Trousers")
    {_inv}.setLeggings(zrDress({_l}, "LEGS"))
    set {_b} to {_inv}.getBoots()
    if zrIsEmpty({_b}) is true:
        set {_b} to zrSpawned("LEATHER_BOOTS", "&5&lZero's Boots")
    {_inv}.setBoots(zrDress({_b}, "FEET"))
    {_p}.updateInventory()
    play sound "item.armor.equip_elytra" with volume 1 and pitch 0.8 at {_p}
    play sound "entity.evoker.prepare_summon" with volume 0.5 and pitch 1.4 at {_p}
    {_p}.getWorld().spawnParticle(Particle.DUST, {_p}.getLocation().add(0, 1, 0), 40, 0.4, 0.8, 0.4, 0, new GeassDust(Color.fromRGB(90, 40, 170), 1.2))
    send "{@p} &5Zero &7has arrived. &8(sneak + F opens the mask's eye; /zero again to take it off)" to {_p}

function zrOff(p: player):
    set {_inv} to {_p}.getInventory()
    set {_h} to {_inv}.getHelmet()
    if gsZero({_h}) is true:
        set {_m} to {_h}.getItemMeta()
        {_m}.getPersistentDataContainer().remove(gsKey("geass_zero"))
        {_m}.getPersistentDataContainer().remove(gsKey("geass_lit"))
        if {_m}.getPersistentDataContainer().has(gsKey("zero_spawned"), PersistentDataType.STRING) is true:
            {_inv}.setHelmet(null)
        else:
            if {_m}.getPersistentDataContainer().has(gsKey("zero_gsauto"), PersistentDataType.STRING) is true:
                gsSetLook({_m}, "none")
                {_m}.getPersistentDataContainer().remove(gsKey("geass_skin"))
                {_m}.getPersistentDataContainer().remove(gsKey("zero_gsauto"))
            else:
                gsSetLook({_m}, "geass")
            {_h}.setItemMeta({_m})
            set {_styled} to gsLore({_h})
            if {_styled} is set:
                set {_h} to {_styled}
            {_inv}.setHelmet({_h})
    {_inv}.setChestplate(zrUndress({_inv}.getChestplate()))
    {_inv}.setLeggings(zrUndress({_inv}.getLeggings()))
    {_inv}.setBoots(zrUndress({_inv}.getBoots()))
    {_p}.updateInventory()
    play sound "item.armor.equip_leather" with volume 1 and pitch 0.8 at {_p}
    send "{@p} &7Zero's mask comes off." to {_p}

command /zero [<text>]:
    usage: /zero [on|off]
    trigger:
        if sender is not a player:
            send "&7Run /zero in game."
            stop
        if zrCan(player) is not true:
            send "&cOnly the owners may wear Zero's mask."
            stop
        if arg-1 is "off":
            zrOff(player)
        else if arg-1 is "on":
            zrOn(player)
        else if gsZero(player.getInventory().getHelmet()) is true:
            zrOff(player)
        else:
            zrOn(player)

on PlayerSwapHandItemsEvent with priority lowest:
    set {_e} to event
    set {_p} to {_e}.getPlayer()
    {_p}.isSneaking() is true
    gsWorn({_p}.getInventory().getHelmet()) is set
    {_e}.setCancelled(true)
    gsActivate({_p})

command /geass [<text>] [<text>]:
    usage: /geass | /geass give <player> | /geass inspect <serial>
    trigger:
        if arg-1 is not set:
            if sender is not a player:
                send "&7/geass give <player>"
                stop
            gsActivate(player)
            stop
        if arg-1 is "test":
            if sender is not a player:
                send "&7Run /geass test in game."
                stop
            if sender is not op:
                if sender doesn't have permission "elytro.skins.admin":
                    if sender doesn't have permission "ebu.use":
                        send "&cStaff only."
                        stop
            gsGiveTest(player)
            stop
        if sender is not op:
            if sender doesn't have permission "elytro.skins.admin":
                send "&cYou don't have permission to issue reward skins."
                stop
        if arg-1 is "clearserial" or "unserial":
            if sender is not a player:
                send "&7Hold the voucher or skinned helmet and run /geass clearserial."
                stop
            set {_it} to player.getInventory().getItemInMainHand()
            set {_s} to gsSerial({_it})
            set {_voucher} to true
            if {_s} is not set:
                set {_voucher} to false
                if gsIsHelmet({_it}) is true:
                    if {_it}.hasItemMeta() is true:
                        set {_s} to {_it}.getItemMeta().getPersistentDataContainer().get(gsKey("geass_skin"), PersistentDataType.STRING)
            if {_s} is not set:
                send "{@p} &7Hold a Geass voucher or a helmet wearing it."
                stop
            if {_s} is "test":
                send "{@p} &7That is already an unnumbered test copy."
                stop
            if gsValid({_s}, gsToken({_it})) is true:
                set {_retired} to gsRetire({_s}, "%sender%")
            if {_voucher} is true:
                set {_it} to gsItem("test")
            else:
                set {_m} to {_it}.getItemMeta()
                {_m}.getPersistentDataContainer().set(gsKey("geass_skin"), PersistentDataType.STRING, "test")
                {_m}.getPersistentDataContainer().remove(gsKey("geass_token"))
                {_it}.setItemMeta({_m})
                set {_new} to gsLore({_it})
                if {_new} is set:
                    set {_it} to {_new}
            player.getInventory().setItemInMainHand({_it})
            set {_scrubbed} to gsScrubOnline()
            send "{@p} &7Held copy is now &cTEST &8(no serial)&7. The helmet is unchanged."
            if {_retired} is true:
                send "&7Retired &c#%{_s}%&7; that number is available for a real reward again. Old copies are invalid."
            stop
        if arg-1 is "revoke":
            set {_s} to arg-2
            if {_s} is not set:
                send "&7/geass revoke <serial>"
                stop
            if gsRetire({_s}, "%sender%") is not true:
                send "{@p} &7That serial is unknown or already revoked."
                stop
            set {_scrubbed} to gsScrubOnline()
            send "{@p} &7Revoked &c#%{_s}%&7. Its number is available again; old copies cannot impersonate the replacement."
            stop
        if arg-1 is "inspect":
            if arg-2 is not set:
                send "&7/geass inspect <serial>"
                stop
            set {_s} to arg-2
            set {_state} to {geass.state::%{_s}%}
            if {_state} is not set:
                set {_state} to "UNKNOWN"
            send "{@p} &c#%{_s}% &7— %{_state}%"
            if {geass.log::%{_s}%} is set:
                send "&7%{geass.log::%{_s}%}%"
            stop
        if arg-1 is "give":
            set {_name} to arg-2
        else if arg-2 is not set:
            set {_name} to arg-1
        if {_name} is not set:
            send "&7/geass give <player>"
            stop
        set {_p} to Bukkit.getPlayerExact({_name})
        if {_p} is not set:
            send "&cThat player must be online."
            stop
        if gsHasSpace({_p}) is not true:
            send "&cTheir inventory is full. Free one slot first."
            stop
        set {_s} to gsIssue({_p}, "given by %sender%")
        send "{@p} &7Gave &cGeass #%{_s}% &7to &f%{_p}.getName()%&7."
        send "{@p} &7You received &cGeass #%{_s}%&7. Drop it onto a helmet to apply." to {_p}

on TabCompleteEvent:
    set {_e} to event
    set {_parts::*} to ...{_e}.getBuffer().split(" ", -1)
    "%{_parts::1}%".toLowerCase() is "/geass"
    set {_sender} to {_e}.getSender()
    set {_out} to new ArrayList()
    if {_sender}.isOp() is not true:
        if {_sender}.hasPermission("elytro.skins.admin") is not true:
            if {_sender}.hasPermission("ebu.use") is true:
                {_out}.add("test")
            {_e}.setCompletions({_out})
            stop
    set {_size} to size of {_parts::*}
    set {_last} to "%{_parts::%{_size}%}%".toLowerCase()
    if {_size} is 2:
        loop "give", "test", "clearserial", "revoke" and "inspect":
            if loop-value.startsWith({_last}) is true:
                {_out}.add(loop-value)
    else if {_size} is 3:
        if "%{_parts::2}%".toLowerCase() is "give":
            loop all players:
                if loop-player.getName().toLowerCase().startsWith({_last}) is true:
                    {_out}.add(loop-player.getName())
        else if "%{_parts::2}%".toLowerCase() is "revoke" or "inspect":
            loop indices of {geass.state::*}:
                if loop-value.startsWith({_last}) is true:
                    {_out}.add(loop-value)
    {_e}.setCompletions({_out})
